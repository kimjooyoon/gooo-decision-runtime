package requirements
namespace requirements
entity Integer id "requirements://integer"
activity Choose(Integer) -> Integer computes "if input < 37 { return 37 - input } else { return input - 37 }" assembling {
 choice "comparison" operand_order at "0" intent "작성한 입력에서 비교 결과를 맞춘다. Match the declared comparison results."
 choice "branches" branch_layout at "0" intent "출력 예시와 중간 조건을 함께 만족하는 처리 순서를 고른다."
 case "-9007199254740995" -> "-9007199254741032"
 case "0" -> "-37"
 case "36" -> "-1"
 case "37" -> "0"
 case "38" -> "-1"
 case "9007199254740993" -> "-9007199254740956"
 case "9007199254740995" -> "-9007199254740958"
 case "18014398509481990" -> "-18014398509481953"
 condition_case "comparison" input "-9007199254740995" -> "true"
 condition_case "comparison" input "37" -> "false"
 condition_case "comparison" input "18014398509481990" -> "false"
 attempts "4"
}

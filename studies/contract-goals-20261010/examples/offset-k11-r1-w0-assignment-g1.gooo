package contractgoals
namespace contractgoals
entity Integer id "contractgoals://integer"
activity Choose(Integer) -> Integer computes "let value = input; let limit = 11; let result = input; if value < limit { result = value - limit } else { result = value + limit }; return result" assembling {
 choice "comparison" operand_order at "0" intent "입력이 기준보다 작은지 확인한다. Compare input with the threshold."
 choice "branches" branch_layout at "0" intent "선언된 입출력 사례에 맞는 경로를 선택한다."
 case "-9007199254740995" -> "-9007199254741006"
 case "0" -> "-11"
 case "10" -> "-1"
 case "11" -> "22"
 case "12" -> "23"
 case "9007199254740993" -> "9007199254741004"
 case "9007199254740995" -> "9007199254741006"
 case "18014398509481990" -> "18014398509482001"
 condition_case "comparison" input "-9007199254740995" -> "true"
 condition_case "comparison" input "11" -> "false"
 condition_case "comparison" input "18014398509481990" -> "false"
 attempts "4"
}

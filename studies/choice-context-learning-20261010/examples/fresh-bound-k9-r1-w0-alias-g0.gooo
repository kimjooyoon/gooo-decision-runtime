package choicecontexts
namespace choicecontexts
entity Integer id "choicecontexts://integer"
activity Choose(Integer) -> Integer computes "let value = input; let limit = 9; if value < limit { return limit } else { return value }" assembling {
 choice "comparison" operand_order at "0" intent "입력이 기준보다 작은지 확인한다. Compare input with the threshold."
 choice "branches" branch_layout at "0" intent "입력과 정답의 짝을 모두 만족하는 처리 순서를 고른다."
 case "-9007199254740995" -> "-9007199254740995"
 case "0" -> "0"
 case "8" -> "8"
 case "9" -> "9"
 case "10" -> "9"
 case "9007199254740993" -> "9"
 case "9007199254740995" -> "9"
 case "18014398509481990" -> "9"
 condition_case "comparison" input "-9007199254740995" -> "true"
 condition_case "comparison" input "9" -> "false"
 condition_case "comparison" input "18014398509481990" -> "false"
 attempts "4"
}
